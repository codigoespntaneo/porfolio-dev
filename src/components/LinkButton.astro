---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    role="link"
    class="inline-flex bg-gray-100 text-gray-700 border-gray-200 items-center justify-center gap-2 px-4 py-2.5 space-x-2 text-sm font-medium transition-all duration-300 dark:text-gray-200 dark:bg-gray-800 border dark:border-gray-700 focus-visible:ring-blue-500/80 hover:bg-gray-900 hover:border-gray-700 group max-w-fit rounded-xl hover:text-white hover:shadow-lg focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:scale-95"
>
    <slot />
</a>
