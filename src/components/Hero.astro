---
const personalImageAlt = "Jean Otero"
import Badge from "../components/Badge.astro"
import LinkedInIcon from "../components/icons/LinkedIn.astro"
import MailIcon from "../components/icons/Mail.astro"
import SocialPill from "../components/SocialPill.astro"
---

<div class="max-w-2xl">
  <div class="flex gap-4 mb-6">
    <img
      class="rounded-full shadow-lg size-20 ring-2 ring-gray-200 dark:ring-gray-700"
      src="https://avatars.githubusercontent.com/u/86264981?s=400&u=3ae5cc4d6032475cdb7c5fc9155e4e636ed2ec2a&v=4"
      alt={personalImageAlt}
    />
    <a
      href="https://www.linkedin.com/in/codigoespntaneo/"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>Disponible para trabajar</Badge>
    </a>
  </div>
  <h1
    class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl lg:text-6xl dark:text-white mb-6"
  >
    Hey, soy <span class="text-blue-600 dark:text-blue-400">Jean Otero</span>
  </h1>
  <p
    class="mt-6 text-xl text-gray-600 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300 leading-relaxed"
  >
    +3 años de experiencia. <strong
      >Ingeniero de Software</strong
    > de Barcelona, España 🇪🇸. Especializado en el desarrollo de aplicaciones web
    únicas.
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:jeanjose.om@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/codigoespntaneo/">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
